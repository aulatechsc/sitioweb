# ─── URLs sin .html ────────────────────────────────────────
# Permite que /admisiones sirva admisiones.html. Sin esto, cualquier
# enlace sin la extension (anuncios, links viejos del WordPress,
# resultados de Google) devuelve 404.
<IfModule mod_rewrite.c>
    RewriteEngine On

    # /admisiones  ->  /admisiones.html  (sin cambiar la URL en la barra)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{DOCUMENT_ROOT}/$1.html -f
    RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>

# Pagina de error con el diseño del sitio
ErrorDocument 404 /404.html

# ─── Compresión Gzip ───────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ─── Caché del navegador ───────────────────────────────────
<IfModule mod_expires.c>
    ExpiresActive On

    ExpiresByType image/jpg  "access plus 3 months"
    ExpiresByType image/jpeg "access plus 3 months"
    ExpiresByType image/png  "access plus 3 months"
    ExpiresByType image/gif  "access plus 3 months"
    ExpiresByType image/webp "access plus 3 months"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 year"

    ExpiresByType text/css                "access plus 1 month"
    ExpiresByType application/javascript  "access plus 1 month"

    ExpiresByType font/woff   "access plus 1 year"
    ExpiresByType font/woff2  "access plus 1 year"

    ExpiresByType text/html "access plus 1 hour"
</IfModule>

# ─── Keep-Alive ────────────────────────────────────────────
<IfModule mod_headers.c>
    Header set Connection keep-alive
</IfModule>
